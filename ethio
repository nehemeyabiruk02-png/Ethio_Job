<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EthioHub - Empowering Ethiopians Everywhere</title>
    <!-- Tailwind CSS for modern, clean styling -->
    <script src="https://jsdelivr.net"></script>
    <!-- FontAwesome for visual anchors/icons -->
    <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body class="bg-gray-50 font-sans text-gray-900">

    <!-- NAVIGATION BAR -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="text-2xl font-black text-emerald-600 tracking-tight">EthioHub</span>
                <span class="bg-amber-100 text-amber-800 text-xs font-bold px-2 py-0.5 rounded">Beta</span>
            </div>
            <nav class="hidden md:flex space-x-8 font-medium">
                <a href="#jobs" class="text-gray-600 hover:text-emerald-600 transition">Jobs</a>
                <a href="#education" class="text-gray-600 hover:text-emerald-600 transition">Scholarships</a>
                <a href="#services" class="text-gray-600 hover:text-emerald-600 transition">Essential Services</a>
            </nav>
            <div class="flex items-center gap-4">
                <button onclick="toggleLanguage()" id="langBtn" class="text-sm border border-gray-300 rounded-md px-3 py-1.5 hover:bg-gray-50 font-semibold cursor-pointer">
                    አማርኛ
                </button>
                <a href="#contribute" class="bg-emerald-600 text-white px-4 py-2 rounded-md font-medium text-sm hover:bg-emerald-700 transition">Add Resource</a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="bg-radial from-emerald-50 to-white py-16 px-4 border-b border-gray-100">
        <div class="max-w-4xl mx-auto text-center">
            <h1 id="heroTitle" class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
                Your Gateway to Growth and Local Resources
            </h1>
            <p id="heroSubtitle" class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-8">
                Discover verified jobs, local digital training, international scholarships, and critical citizen utilities tailored for Ethiopians.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-md mx-auto">
                <input type="text" placeholder="Search opportunities (e.g., Remote Coding Jobs)..." class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                <button class="bg-gray-900 text-white font-medium px-6 py-3 rounded-lg hover:bg-gray-800 cursor-pointer whitespace-nowrap">Search</button>
            </div>
        </div>
    </section>

    <!-- CORE CHANNELS / GRID HUBS -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        
        <!-- JOBS & INTERNSHIPS -->
        <section id="jobs" class="mb-16">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold flex items-center gap-2"><i class="fa-solid fa-briefcase text-emerald-600"></i> Employment Opportunities</h2>
                <a href="#" class="text-emerald-600 font-semibold hover:underline text-sm">View All Jobs &rarr;</a>
            </div>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                <!-- Job Card 1 -->
                <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs hover:shadow-md transition">
                    <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded">Remote (Global)</span>
                    <h3 class="font-bold text-lg mt-2">Junior Frontend Developer</h3>
                    <p class="text-gray-500 text-sm mb-4">TechAfrica Solutions</p>
                    <div class="text-xs text-gray-400 flex items-center gap-2"><i class="fa-regular fa-clock"></i> Closes: Oct 25, 2026</div>
                </div>
                <!-- Job Card 2 -->
                <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs hover:shadow-md transition">
                    <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded">Full-Time (Addis Ababa)</span>
                    <h3 class="font-bold text-lg mt-2">Data Analyst</h3>
                    <p class="text-gray-500 text-sm mb-4">Fintech Ethio</p>
                    <div class="text-xs text-gray-400 flex items-center gap-2"><i class="fa-regular fa-clock"></i> Closes: Nov 02, 2026</div>
                </div>
                <!-- Job Card 3 -->
                <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-xs hover:shadow-md transition">
                    <span class="text-xs font-bold text-purple-600 bg-purple-50 px-2 py-1 rounded">Paid Internship</span>
                    <h3 class="font-bold text-lg mt-2">Digital Marketing Intern</h3>
                    <p class="text-gray-500 text-sm mb-4">Creative Hub Ethiopia</p>
                    <div class="text-xs text-gray-400 flex items-center gap-2"><i class="fa-regular fa-clock"></i> Closes: Oct 18, 2026</div>
                </div>
            </div>
        </section>

        <!-- EDUCATION & SCHOLARSHIPS -->
        <section id="education" class="mb-16">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold flex items-center gap-2"><i class="fa-solid fa-graduation-cap text-amber-600"></i> Education & Skills</h2>
                <a href="#" class="text-amber-600 font-semibold hover:underline text-sm">View All Learning &rarr;</a>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
                <div class="bg-amber-50/50 p-6 rounded-xl border border-amber-100 flex gap-4">
                    <div class="text-3xl text-amber-600"><i class="fa-solid fa-earth-africa"></i></div>
                    <div>
                        <h3 class="font-bold text-lg">Fully Funded Master's Scholarships</h3>
                        <p class="text-gray-600 text-sm mt-1">Curated list of international universities offering full rides to Ethiopian students for the 2027 academic cycle.</p>
                    </div>
                </div>
                <div class="bg-blue-50/50 p-6 rounded-xl border border-blue-100 flex gap-4">
                    <div class="text-3xl text-blue-600"><i class="fa-solid fa-code"></i></div>
                    <div>
                        <h3 class="font-bold text-lg">Free Software Bootcamps</h3>
                        <p class="text-gray-600 text-sm mt-1">Access local and international hybrid training paths offering free certificates in coding, product design, and AI tools.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- UTILITY & CITIZEN SERVICES -->
        <section id="services" class="mb-16">
            <h2 class="text-2xl font-bold flex items-center gap-2 mb-6"><i class="fa-solid fa-circle-info text-blue-600"></i> Essential Citizen Toolkit</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div class="bg-white border border-gray-200 p-4 rounded-lg flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-lg"><i class="fa-solid fa-phone-flip"></i></div>
                    <div>
                        <h4 class="font-semibold text-sm">Emergency Hotlines</h4>
                        <p class="text-xs text-gray-500">Quick list of response lines</p>
                    </div>
                </div>
                <div class="bg-white border border-gray-200 p-4 rounded-lg flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-lg"><i class="fa-solid fa-passport"></i></div>
                    <div>
                        <h4 class="font-semibold text-sm">Passport Guide</h4>
                        <p class="text-xs text-gray-500">Links to digital applications</p>
                    </div>
                </div>
                <div class="bg-white border border-gray-200 p-4 rounded-lg flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-yellow-100 text-yellow-600 flex items-center justify-center text-lg"><i class="fa-solid fa-money-bill-transfer"></i></div>
                    <div>
                        <h4 class="font-semibold text-sm">Remittance Trackers</h4>
                        <p class="text-xs text-gray-500">Compare transfer service rates</p>
                    </div>
                </div>
                <div class="bg-white border border-gray-200 p-4 rounded-lg flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center text-lg"><i class="fa-solid fa-building-columns"></i></div>
                    <div>
                        <h4 class="font-semibold text-sm">Tax & Duty Calculators</h4>
                        <p class="text-xs text-gray-500">Calculate custom clearance fees</p>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-gray-900 text-gray-400 py-8 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 text-center text-sm">
            <p>&copy; 2026 EthioHub. Designed to elevate, connect, and empower.</p>
        </div>
    </footer>

    <!-- LANGUAGE TOGGLE LOGIC -->
    <script>
        let currentLang = 'en';
        function toggleLanguage() {
